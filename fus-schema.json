{
    "buildNumber": "1.0",
    "recorderScheme": [
        {
            "recorderId": "KTC",
            "recorderVersion": 1,
            "ids": [
                {
                    "path": "machine_id",
                    "required": true,
                    "values": [
                        "{regexp#hash}"
                    ]
                },
                {
                    "path": "project_id",
                    "required": false,
                    "values": [
                        "{regexp#hash}"
                    ]
                }
            ],
            "clientData": [],
            "systemData": []
        }
    ],
    "scheme": [
        {
            "id": "ktc.command",
            "type": "counter",
            "version": 3,
            "description": "Command execution events",
            "schema": [
                {
                    "event": "ktc.command.invoked",
                    "description": "A CLI command was invoked",
                    "fields": [
                        {
                            "path": "caller_type",
                            "description": "The source of the CLI call (IDE, AI Agent, regular user in the terminal, etc.)",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:ai_agent|ci|ide|terminal}"
                            ]
                        },
                        {
                            "path": "command",
                            "description": "The name of the invoked command, or null if the 'kotlin' CLI was invoked without a command. Required if 'subcommand' is not empty.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:build|check|clean|clean-shared-caches|compose-hot-reload-mcp-server|data-collection-consent|do|generate-completion|ide-integration|init|new|package|publish|run|show|task|test|tool|update}"
                            ]
                        },
                        {
                            "path": "interactive",
                            "description": "Whether the command was run in an interactive terminal.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "subcommand",
                            "description": "The name of the invoked subcommands (like 'jdk' for 'kotlin tool jdk'), or an empty list if no subcommands were passed (like 'kotlin build'). This is a list because some commands may allow multiple subcommands in the same command line.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:checks|commands|dependencies|modules|settings|tasks|jaeger|jdk|keystore|klib|xcode-integration|convert-project|commonize-native-distribution|generate-klibs|manage-xcode|prepare-compose-resources|give|revoke|show}"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "ktc.environment",
            "type": "state",
            "version": 2,
            "description": "Environment state events",
            "schema": [
                {
                    "event": "ktc.environment.state",
                    "description": "Environment state",
                    "fields": [
                        {
                            "path": "ai_agent",
                            "description": "The AI agent running the current CLI command, or null if no agent was detected",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:cursor|cursor-cli|kimi|grok|gemini-cli|cline|codex|antigravity|augment-cli|opencode|goose|junie|pi|claude-code|replit|github-copilot|kiro|openclaw|devin|other}"
                            ]
                        },
                        {
                            "path": "ci_system",
                            "description": "The CI system the current call is running on, or null if not running on CI",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:appveyor|codebuild|azure_pipelines|bitbucket|buildkite|circle_ci|github|gitlab|jenkins|teamcity|travis_ci|other}"
                            ]
                        },
                        {
                            "path": "cpu_arch",
                            "description": "The CPU architecture of the current machine",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:x86_64|arm64}"
                            ]
                        },
                        {
                            "path": "os_family",
                            "description": "The operating system family of the current machine",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:windows|linux|macos|freebsd|solaris}"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "ktc.project",
            "type": "counter",
            "version": 2,
            "description": "Project-related events of type COUNTER",
            "schema": [
                {
                    "event": "ktc.project.created",
                    "description": "A new project was generated",
                    "fields": [
                        {
                            "path": "ai_enabled",
                            "description": "Whether AI agent configuration was enabled. The CLI default is true, and requires an explicit opt-out using --no-ai.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "configured_ai_agents",
                            "description": "The AI agents that the generated project was configured for, or an empty list if no agent configuration was generated.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:antigravity|augment-cli|claude-code|cline|codex|cursor|cursor-cli|devin|gemini-cli|github-copilot|goose|grok|junie|kimi|kiro|openclaw|opencode|other|pi|replit}"
                            ]
                        },
                        {
                            "path": "git_enabled",
                            "description": "Whether Git initialization and Git files was enabled. The CLI default is true, and requires an explicit opt-out using --no-git.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "target_platforms",
                            "description": "The target platforms selected in the Kotlin Multiplatform wizard, or null if the project was generated from a template without platform selection.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|desktop|ios|server|web}"
                            ]
                        },
                        {
                            "path": "template_id",
                            "description": "The id of the project template that the new project was generated from. Projects generated by the parameterized Kotlin Multiplatform wizard report 'kotlin-multiplatform-app'.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:compose-android|compose-desktop|jvm-cli|kotlin-multiplatform-app|kotlin-multiplatform-library|ktor-server|spring-boot-kotlin}"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}