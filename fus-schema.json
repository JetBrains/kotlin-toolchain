{
    "buildNumber": "1.0",
    "recorderScheme": [
        {
            "recorderId": "KTC",
            "recorderVersion": 1,
            "ids": [
                {
                    "path": "machine_id",
                    "required": true,
                    "values": [
                        "{regexp#hash}"
                    ]
                },
                {
                    "path": "project_id",
                    "required": false,
                    "values": [
                        "{regexp#hash}"
                    ]
                }
            ],
            "clientData": [],
            "systemData": []
        }
    ],
    "scheme": [
        {
            "id": "ktc.anonymous",
            "type": "state",
            "version": 1,
            "description": "Fully anonymous events for aggregated statistics that don't require user consent",
            "recorder": "KTC",
            "schema": [
                {
                    "event": "ktc.anonymous.consent.state",
                    "description": "The current state of the user's consent for statistical analysis only. This event is reported at most once per day and contains no identifier.",
                    "fields": [
                        {
                            "path": "caller_type",
                            "description": "The source of the CLI call (IDE, AI Agent, regular user in the terminal, etc.)",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:ai_agent|ci|ide|terminal}"
                            ]
                        },
                        {
                            "path": "consent_state",
                            "description": "Whether the user accepted or rejected the collection of usage statistics, or was not asked yet (for example, because the terminal was not interactive).",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:accepted|rejected|not_asked}"
                            ]
                        },
                        {
                            "path": "ide",
                            "description": "The IDE running the current CLI command, or null if no IDE was detected",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:idea-ultimate|idea-community|android-studio|other}"
                            ]
                        },
                        {
                            "path": "interactive",
                            "description": "Whether the command was run in an interactive terminal.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "ktc_version",
                            "description": "The currently running version of the Kotlin Toolchain. The dev build number is trimmed.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:LOCAL-SNAPSHOT|0.11.0-dev|0.11.0|0.11.1|0.11.2|0.11.3|0.11.4|0.11.5|0.12.0-dev|0.12.0|0.12.1|0.12.2|0.12.3|0.12.4|0.12.5|0.13.0-dev|0.13.0|0.13.1|0.13.2|0.13.3|0.13.4|0.13.5|0.14.0-dev|0.14.0|0.14.1|0.14.2|0.14.3|0.14.4|0.14.5|0.15.0-dev|0.15.0|0.15.1|0.15.2|0.15.3|0.15.4|0.15.5|0.16.0-dev|0.16.0|0.16.1|0.16.2|0.16.3|0.16.4|0.16.5}"
                            ]
                        },
                        {
                            "path": "os_family",
                            "description": "The operating system family of the current machine",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:windows|macos|unix_like}"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "ktc.command",
            "type": "counter",
            "version": 10,
            "description": "Command execution events",
            "recorder": "KTC",
            "schema": [
                {
                    "event": "ktc.command.invoked",
                    "description": "A CLI command was invoked. This event also contains contextual information like OS/arch, whether the command was run by an AI agent, CI, or IDE, etc.",
                    "fields": [
                        {
                            "path": "ai_agent",
                            "description": "The AI agent running the current CLI command, or null if no agent was detected",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:cursor|cursor-cli|kimi|grok|gemini-cli|cline|codex|antigravity|augment-cli|opencode|goose|junie|pi|claude-code|replit|github-copilot|kiro|openclaw|devin|other}"
                            ]
                        },
                        {
                            "path": "caller_type",
                            "description": "The source of the CLI call (IDE, AI Agent, regular user in the terminal, etc.)",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:ai_agent|ci|ide|terminal}"
                            ]
                        },
                        {
                            "path": "ci_system",
                            "description": "The CI system the current call is running on, or null if not running on CI",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:appveyor|codebuild|azure_pipelines|bitbucket|buildkite|circle_ci|github|gitlab|jenkins|teamcity|travis_ci|other}"
                            ]
                        },
                        {
                            "path": "command",
                            "description": "The name of the invoked command, or null if the 'kotlin' CLI was invoked without a command. Required if 'subcommands' is not empty.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:build|check|clean|clean-shared-caches|compose-hot-reload-mcp-server|data-collection-consent|do|generate-completion|ide-integration|init|new|package|publish|run|show|task|test|tool|update}"
                            ]
                        },
                        {
                            "path": "cpu_arch",
                            "description": "The CPU architecture of the current machine",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:x86_64|arm64}"
                            ]
                        },
                        {
                            "path": "ide",
                            "description": "The IDE running the current CLI command, or null if no IDE was detected",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:idea-ultimate|idea-community|android-studio|other}"
                            ]
                        },
                        {
                            "path": "interactive",
                            "description": "Whether the command was run in an interactive terminal.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "ktc_version",
                            "description": "The currently running version of the Kotlin Toolchain. The dev build number is trimmed.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:LOCAL-SNAPSHOT|0.11.0-dev|0.11.0|0.11.1|0.11.2|0.11.3|0.11.4|0.11.5|0.12.0-dev|0.12.0|0.12.1|0.12.2|0.12.3|0.12.4|0.12.5|0.13.0-dev|0.13.0|0.13.1|0.13.2|0.13.3|0.13.4|0.13.5|0.14.0-dev|0.14.0|0.14.1|0.14.2|0.14.3|0.14.4|0.14.5|0.15.0-dev|0.15.0|0.15.1|0.15.2|0.15.3|0.15.4|0.15.5|0.16.0-dev|0.16.0|0.16.1|0.16.2|0.16.3|0.16.4|0.16.5}"
                            ]
                        },
                        {
                            "path": "oldest_installed_ktc_version",
                            "description": "The oldest version of the Kotlin Toolchain installed in the user's cache. The dev build number is trimmed.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:LOCAL-SNAPSHOT|0.11.0-dev|0.11.0|0.11.1|0.11.2|0.11.3|0.11.4|0.11.5|0.12.0-dev|0.12.0|0.12.1|0.12.2|0.12.3|0.12.4|0.12.5|0.13.0-dev|0.13.0|0.13.1|0.13.2|0.13.3|0.13.4|0.13.5|0.14.0-dev|0.14.0|0.14.1|0.14.2|0.14.3|0.14.4|0.14.5|0.15.0-dev|0.15.0|0.15.1|0.15.2|0.15.3|0.15.4|0.15.5|0.16.0-dev|0.16.0|0.16.1|0.16.2|0.16.3|0.16.4|0.16.5}"
                            ]
                        },
                        {
                            "path": "os_family",
                            "description": "The operating system family of the current machine",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:windows|linux|macos|freebsd|solaris}"
                            ]
                        },
                        {
                            "path": "subcommand",
                            "description": "The name of the invoked subcommands (like 'jdk' for 'kotlin tool jdk'), or an empty list if no subcommands were passed (like 'kotlin build'). This is a list because some commands may allow multiple subcommands in the same command line.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:checks|commands|dependencies|modules|settings|tasks|jaeger|jdk|keystore|klib|xcode-integration|convert-project|commonize-native-distribution|generate-klibs|manage-xcode|prepare-compose-resources|give|revoke|show}"
                            ]
                        }
                    ]
                },
                {
                    "event": "ktc.command.invoked.build",
                    "description": "The `kotlin build` command was invoked",
                    "fields": [
                        {
                            "path": "module_count",
                            "description": "The number of modules built by this command.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:0|1|2|3-5|6-10|11-20|21-50|51-100|101-300|301+}"
                            ]
                        },
                        {
                            "path": "modules_filtered",
                            "description": "Whether the build was restricted to specific modules on the command line.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "platforms",
                            "description": "The platforms that this command builds for.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|android_native_arm32|android_native_arm64|android_native_x64|android_native_x86|ios_arm64|ios_simulator_arm64|ios_x64|js|jvm|linux_arm64|linux_x64|macos_arm64|macos_x64|mingw_x64|tvos_arm64|tvos_simulator_arm64|tvos_x64|wasm_js|wasm_wasi|watchos_arm32|watchos_arm64|watchos_device_arm64|watchos_simulator_arm64}"
                            ]
                        },
                        {
                            "path": "requested_build_types",
                            "description": "The build variants requested on the command line, or null if none was requested (in which case only the debug variant is built).",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:debug|release}"
                            ]
                        },
                        {
                            "path": "requested_platforms",
                            "description": "The platforms requested on the command line, or null if none was requested (in which case all the platforms of the project are built). See built_platforms for the list of platforms that was effectively built.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|android_native_arm32|android_native_arm64|android_native_x64|android_native_x86|ios_arm64|ios_simulator_arm64|ios_x64|js|jvm|linux_arm64|linux_x64|macos_arm64|macos_x64|mingw_x64|tvos_arm64|tvos_simulator_arm64|tvos_x64|wasm_js|wasm_wasi|watchos_arm32|watchos_arm64|watchos_device_arm64|watchos_simulator_arm64}"
                            ]
                        }
                    ]
                },
                {
                    "event": "ktc.command.invoked.publish",
                    "description": "The `kotlin publish` command was invoked",
                    "fields": [
                        {
                            "path": "modules_filtered",
                            "description": "Whether the publication was restricted to specific modules on the command line. The module names themselves are not reported.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "transitive",
                            "description": "Whether the `--transitive`/`--non-transitive` option was used, and with which value. 'auto' means that neither option was passed on the command line.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:true|false|auto}"
                            ]
                        },
                        {
                            "path": "type",
                            "description": "The kind of publication that was requested. This is 'ios' or 'maven', based on the special 'testflight' repository ID.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:maven|ios}"
                            ]
                        }
                    ]
                },
                {
                    "event": "ktc.command.invoked.run",
                    "description": "The `kotlin run` command was invoked",
                    "fields": [
                        {
                            "path": "compose_hot_reload",
                            "description": "Whether the app was run with Compose Hot Reload and how.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:enabled_by_default|enabled_explicitly|disabled_explicitly|not_applicable}"
                            ]
                        },
                        {
                            "path": "module_source",
                            "description": "Whether the module to run was specified explicitly by the user on the command line, prompted interactively, or inferred because there was no ambiguity.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:cli_option|prompted|inferred}"
                            ]
                        },
                        {
                            "path": "platform",
                            "description": "The platform that the app was run on.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:jvm|android|js|wasm_js|wasm_wasi|linux_x64|linux_arm64|macos_x64|macos_arm64|tvos_arm64|tvos_x64|tvos_simulator_arm64|ios_arm64|ios_simulator_arm64|ios_x64|watchos_arm64|watchos_arm32|watchos_device_arm64|watchos_simulator_arm64|mingw_x64|android_native_arm32|android_native_arm64|android_native_x64|android_native_x86}"
                            ]
                        },
                        {
                            "path": "platform_source",
                            "description": "Whether the platform to run was specified explicitly by the user on the command line, prompted interactively, or inferred because there was no ambiguity.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:cli_option|prompted|inferred}"
                            ]
                        },
                        {
                            "path": "product_type",
                            "description": "The product type of the module that was run.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android/app|ios/app|js/app|jvm/amper-plugin|jvm/app|jvm/lib|kmp/lib|linux/app|macos/app|wasm-js/app|wasm-wasi/app|windows/app}"
                            ]
                        }
                    ]
                },
                {
                    "event": "ktc.command.invoked.test",
                    "description": "The `kotlin test` command was invoked",
                    "fields": [
                        {
                            "path": "module_count",
                            "description": "The number of modules tested by this command.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:0|1|2|3-5|6-10|11-20|21-50|51-100|101-300|301+}"
                            ]
                        },
                        {
                            "path": "modules_filtered",
                            "description": "Whether the tests were restricted to specific modules on the command line (by including or excluding modules). The module names themselves are not reported.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "platforms",
                            "description": "The platforms tested by this command.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|android_native_arm32|android_native_arm64|android_native_x64|android_native_x86|ios_arm64|ios_simulator_arm64|ios_x64|js|jvm|linux_arm64|linux_x64|macos_arm64|macos_x64|mingw_x64|tvos_arm64|tvos_simulator_arm64|tvos_x64|wasm_js|wasm_wasi|watchos_arm32|watchos_arm64|watchos_device_arm64|watchos_simulator_arm64}"
                            ]
                        },
                        {
                            "path": "requested_build_type",
                            "description": "The build variant requested on the command line, or null if none was requested (in which case the debug variant is tested).",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:debug|release}"
                            ]
                        },
                        {
                            "path": "requested_platforms",
                            "description": "The platforms requested on the command line, or an empty list if none was requested (in which case tests are run for all the platforms of the project).",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|android_native_arm32|android_native_arm64|android_native_x64|android_native_x86|ios_arm64|ios_simulator_arm64|ios_x64|js|jvm|linux_arm64|linux_x64|macos_arm64|macos_x64|mingw_x64|tvos_arm64|tvos_simulator_arm64|tvos_x64|wasm_js|wasm_wasi|watchos_arm32|watchos_arm64|watchos_device_arm64|watchos_simulator_arm64}"
                            ]
                        },
                        {
                            "path": "used_test_filter_kinds",
                            "description": "The kinds of test filters that were used, or an empty list if no filter was used. The filter values themselves are not reported.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:exclude_class_pattern|exclude_tag|include_class|include_class_pattern|include_tag|include_test}"
                            ]
                        }
                    ]
                },
                {
                    "event": "ktc.command.result",
                    "description": "A CLI command completed. This event is reported for any command, and complements the corresponding 'ktc.command.invoked*' events with the outcome of the execution.",
                    "fields": [
                        {
                            "path": "command",
                            "description": "The name of the command that completed, or null if the 'kotlin' CLI was invoked without a command. Required if 'subcommands' is not empty.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:build|check|clean|clean-shared-caches|compose-hot-reload-mcp-server|data-collection-consent|do|generate-completion|ide-integration|init|new|package|publish|run|show|task|test|tool|update}"
                            ]
                        },
                        {
                            "path": "result",
                            "description": "The outcome of the command execution.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:success|failure|canceled}"
                            ]
                        },
                        {
                            "path": "subcommand",
                            "description": "The name of the subcommands that completed (like 'jdk' for 'kotlin tool jdk'), or an empty list if no subcommands were passed (like 'kotlin build'). This is a list because some commands may allow multiple subcommands in the same command line.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:checks|commands|dependencies|modules|settings|tasks|jaeger|jdk|keystore|klib|xcode-integration|convert-project|commonize-native-distribution|generate-klibs|manage-xcode|prepare-compose-resources|give|revoke|show}"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "ktc.project",
            "type": "counter",
            "version": 4,
            "description": "Project-related events of type COUNTER",
            "recorder": "KTC",
            "schema": [
                {
                    "event": "ktc.project.created",
                    "description": "A new project was generated",
                    "fields": [
                        {
                            "path": "ai_enabled",
                            "description": "Whether AI agent configuration was enabled. The CLI default is true, and requires an explicit opt-out using --no-ai.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "command",
                            "description": "The command that was used to generate the project.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:new|init}"
                            ]
                        },
                        {
                            "path": "configured_ai_agents",
                            "description": "The AI agents that the generated project was configured for, or an empty list if no agent configuration was generated.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:antigravity|augment-cli|claude-code|cline|codex|cursor|cursor-cli|devin|gemini-cli|github-copilot|goose|grok|junie|kimi|kiro|openclaw|opencode|other|pi|replit}"
                            ]
                        },
                        {
                            "path": "git_enabled",
                            "description": "Whether Git initialization and Git files was enabled. The CLI default is true, and requires an explicit opt-out using --no-git.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum#boolean}"
                            ]
                        },
                        {
                            "path": "target_platforms",
                            "description": "The target platforms selected in the Kotlin Multiplatform wizard, or null if the project was generated from a template without platform selection.",
                            "dataType": "ARRAY",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:android|desktop|ios|server|web}"
                            ]
                        },
                        {
                            "path": "template_id",
                            "description": "The id of the project template that the new project was generated from. Projects generated by the parameterized Kotlin Multiplatform wizard report 'kotlin-multiplatform-app'.",
                            "dataType": "PRIMITIVE",
                            "shouldBeAnonymized": false,
                            "value": [
                                "{enum:compose-android|compose-desktop|jvm-cli|kotlin-multiplatform-app|kotlin-multiplatform-library|ktor-server|spring-boot-kotlin}"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}